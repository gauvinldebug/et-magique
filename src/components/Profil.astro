---
// « Personnalise le site » : trois questions facultatives (classe, spécialités, difficultés).
// Ensuite : un bloc « Pour toi » avec des chapitres suggérés, et le site masque ce qui ne concerne pas l'élève.
// Rien n'est envoyé : tout reste dans le navigateur.
import { MATIERES } from '../data/site';
const NOMS = Object.fromEntries(MATIERES.map((m) => [m.slug, m.nom]));
---
<section class="profil" id="profil" aria-labelledby="profil-t" data-noms={JSON.stringify(NOMS)}>
  <div class="wrap">
    <div class="profil-carte" data-vue="question" hidden>
      <div class="profil-tete">
        <p class="profil-k">Personnalise le site</p>
        <button type="button" class="profil-plus-tard" data-plus-tard>Plus tard</button>
      </div>
      <h2 id="profil-t" class="profil-q" data-q></h2>
      <p class="profil-aide" data-aide></p>
      <div class="profil-choix" data-choix role="group"></div>
      <div class="profil-pied">
        <span class="profil-etape" data-etape></span>
        <button type="button" class="btn" data-suivant hidden>Suivant</button>
      </div>
    </div>

    <div class="profil-carte profil-toi" data-vue="toi" hidden>
      <div class="profil-tete">
        <p class="profil-k">Pour toi</p>
        <button type="button" class="profil-plus-tard" data-modifier>Modifier</button>
      </div>
      <p class="profil-resume" data-resume></p>
      <ul class="profil-sugg" data-sugg></ul>
    </div>

    <p class="profil-mini" data-vue="mini" hidden><button type="button" data-rouvrir>Personnalise le site en trois questions</button></p>
  </div>
</section>

<script>
  import { lire, ecrire, CLASSES, SPECIALITES, avecSpecialites, matieresDeClasse, matieresUtiles, type Profil } from '../scripts/profil';

  const racine = document.querySelector<HTMLElement>('#profil');
  if (racine) {
    const NOMS: Record<string, string> = JSON.parse(racine.dataset.noms || '{}');
    const vues = [...racine.querySelectorAll<HTMLElement>('[data-vue]')];
    const montrer = (v: string) => vues.forEach((e) => (e.hidden = e.dataset.vue !== v));
    const $ = <T extends HTMLElement>(s: string) => racine.querySelector<T>(s)!;
    const PLUS_TARD = 'profil-plus-tard';
    const plusTard = () => { try { return localStorage.getItem(PLUS_TARD) === '1'; } catch { return false; } };

    let brouillon: Profil = { classe: '', specialites: [], difficultes: [] };
    let etape = 0;

    const etapes = () => (avecSpecialites(brouillon.classe) ? ['classe', 'specialites', 'difficultes'] : ['classe', 'difficultes']);

    function puce(texte: string, actif: boolean, quand: () => void) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'profil-puce';
      b.textContent = texte;
      b.setAttribute('aria-pressed', String(actif));
      b.addEventListener('click', quand);
      return b;
    }

    function question() {
      montrer('question');
      const liste = etapes();
      const q = liste[etape];
      const choix = $<HTMLElement>('[data-choix]');
      const suivant = $<HTMLButtonElement>('[data-suivant]');
      choix.replaceChildren();
      $<HTMLElement>('[data-etape]').textContent = `${etape + 1} sur ${liste.length}`;
      if (q === 'classe') {
        $<HTMLElement>('[data-q]').textContent = 'Tu es en quelle classe ?';
        $<HTMLElement>('[data-aide]').textContent = 'Le site affichera d\'abord ce qui te concerne. Tes réponses restent sur ton appareil.';
        suivant.hidden = true;
        CLASSES.forEach((c) => choix.append(puce(c.court, brouillon.classe === c.slug, () => {
          brouillon = { classe: c.slug, specialites: [], difficultes: [] };
          etape = 1;
          question();
        })));
        return;
      }
      const multi = (cle: 'specialites' | 'difficultes', options: { slug: string; nom: string }[]) => {
        options.forEach((o) => {
          const b = puce(o.nom, brouillon[cle].includes(o.slug), () => {
            const l = brouillon[cle];
            brouillon[cle] = l.includes(o.slug) ? l.filter((x) => x !== o.slug) : [...l, o.slug];
            b.setAttribute('aria-pressed', String(brouillon[cle].includes(o.slug)));
          });
          choix.append(b);
        });
      };
      suivant.hidden = false;
      if (q === 'specialites') {
        $<HTMLElement>('[data-q]').textContent = 'Quelles sont tes spécialités ?';
        $<HTMLElement>('[data-aide]').textContent = brouillon.classe === 'terminale' ? 'En terminale, tu en gardes deux. Coche celles qu\'on propose ici.' : 'Coche celles qu\'on propose ici.';
        multi('specialites', SPECIALITES);
        suivant.textContent = 'Suivant';
      } else {
        $<HTMLElement>('[data-q]').textContent = 'Où as-tu le plus de mal ?';
        $<HTMLElement>('[data-aide]').textContent = 'Plusieurs choix possibles, ou aucun.';
        multi('difficultes', matieresDeClasse(brouillon.classe).map((m) => ({ slug: m, nom: NOMS[m] ?? m })));
        suivant.textContent = 'Terminer';
      }
    }

    $<HTMLButtonElement>('[data-suivant]').addEventListener('click', () => {
      if (etape < etapes().length - 1) { etape++; question(); return; }
      ecrire({ ...brouillon, tout: false });
      (window as any).umami?.track('profil-rempli', { classe: brouillon.classe });
      dispatchEvent(new Event('profil-change'));
      pourToi();
    });
    $<HTMLButtonElement>('[data-plus-tard]').addEventListener('click', () => {
      try { localStorage.setItem(PLUS_TARD, '1'); } catch { /* rien */ }
      if (lire()) pourToi(); else montrer('mini');
    });
    $<HTMLButtonElement>('[data-rouvrir]').addEventListener('click', () => { etape = 0; question(); });
    $<HTMLButtonElement>('[data-modifier]').addEventListener('click', () => {
      brouillon = { ...(lire() ?? { classe: '', specialites: [], difficultes: [] }) };
      etape = 0;
      question();
    });

    type Item = { t: string; s: string; u: string; d: 0 | 1; m?: string };
    async function pourToi() {
      const p = lire();
      if (!p) { question(); return; }
      montrer('toi');
      const classe = CLASSES.find((c) => c.slug === p.classe)?.court ?? p.classe;
      const mats = matieresUtiles(p);
      const parties = [classe];
      if (p.specialites.length) parties.push('spécialités ' + p.specialites.map((m) => NOMS[m]).join(', '));
      if (p.difficultes.length) parties.push('à renforcer : ' + p.difficultes.map((m) => NOMS[m]).join(', '));
      $<HTMLElement>('[data-resume]').textContent = parties.join(' · ');
      const ul = $<HTMLElement>('[data-sugg]');
      ul.replaceChildren();
      let items: Item[] = [];
      try { items = await (await fetch('/recherche.json')).json(); } catch { /* hors ligne */ }
      // d'abord les matières où il a du mal (deux chapitres), puis les autres (un chapitre) :
      // le premier chapitre de son niveau qu'il n'a pas encore coché comme terminé
      const ordre = [...new Set([...p.difficultes, ...mats])];
      const sugg: (Item & { mat: string })[] = [];
      for (const m of ordre) {
        let faits: string[] = [];
        try { faits = JSON.parse(localStorage.getItem(`faits:${m}/${p.classe}`) || '[]'); } catch { /* rien */ }
        const dispo = items.filter((i) => i.d && i.m === m && new RegExp(`^/${m}/${p.classe}/[^/]+/$`).test(i.u) && !faits.includes(i.u.split('/')[3]));
        sugg.push(...dispo.slice(0, p.difficultes.includes(m) ? 2 : 1).map((i) => ({ ...i, mat: m })));
      }
      for (const m of mats) {
        const li = document.createElement('li');
        li.className = 'profil-niv';
        li.dataset.m = m;
        li.innerHTML = `<a href="/${m}/${p.classe}/"><small>${NOMS[m] ?? m}</small><b>Tous mes chapitres de ${classe}</b></a>`;
        if (items.some((i) => i.u === `/${m}/${p.classe}/`)) ul.append(li);
      }
      sugg.slice(0, 6).forEach((i) => {
        const li = document.createElement('li');
        li.dataset.m = i.mat;
        const a = document.createElement('a');
        a.href = i.u;
        a.innerHTML = `<small></small><b></b>`;
        a.querySelector('small')!.textContent = (NOMS[i.mat] ?? '') + (p.difficultes.includes(i.mat) ? ' · à renforcer' : '');
        a.querySelector('b')!.textContent = i.t;
        li.append(a);
        ul.append(li);
      });
    }

    if (lire()) pourToi();
    else if (plusTard()) montrer('mini');
    else question();
  }
</script>
