---
// Le sommaire d'une matière : les niveaux en chiffres géants, avec le nombre de chapitres en ligne.
import { niveauxDe } from '../data/site';
const NIVEAUX_M = (m: string) => niveauxDe(m);
import { chapitresPublies } from '../lib/contenu';
interface Props { matiere: string; titre?: string }
const { matiere, titre = 'Sommaire' } = Astro.props;
const publies = (await chapitresPublies()).filter((c) => c.matiere === matiere);
const nb = (n: string) => publies.filter((c) => c.niveau === n).length;
const NIVEAUX = NIVEAUX_M(matiere);
const principaux = NIVEAUX.filter((n) => n.cycle === 'Collège' || n.cycle === 'Lycée');
const autres = NIVEAUX.filter((n) => !principaux.includes(n) && nb(n.slug) > 0);
const total = publies.length;
const legende = (n: (typeof NIVEAUX)[number]) => {
  const c = nb(n.slug);
  const t = c === 0 ? 'bientôt' : `${c} chapitre${c > 1 ? 's' : ''}`;
  return n.examen ? `${t}, ${n.examen}` : t;
};
---
<section class="som" aria-labelledby={`som-${matiere}`} data-profil-groupe>
  <div class="som-tete"><h2 id={`som-${matiere}`}>{titre}</h2><span>{total} chapitre{total > 1 ? "s" : ""} en ligne</span></div>
  <ul class="som-grille">
    {principaux.map((n) => (
      <li data-niveau={n.slug}><a href={`/${matiere}/${n.slug}/`} class:list={{ examen: n.examen === 'bac' }} aria-label={`${n.nom} : ${legende(n)}`}><b>{n.court}</b><span>{legende(n)}</span></a></li>
    ))}
  </ul>
  {autres.length > 0 && (
    <p class="som-aussi"><span>Aussi :</span>{autres.map((n) => <a data-niveau={n.slug} href={`/${matiere}/${n.slug}/`}>{n.nom}</a>)}</p>
  )}
  <button type="button" class="profil-tout-b" data-profil-tout hidden>Tout afficher</button>
</section>
