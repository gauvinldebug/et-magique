---
// Vignette de la vidéo : un clic ouvre la vidéo sur YouTube (nouvel onglet).
// Aucun lecteur YouTube n'est chargé sur le site, donc aucun cookie ni traceur.
// Si la vidéo n'était pas encore sortie quand le site a été construit, la page la cherche
// au chargement (/api/video) et affiche la vignette dès qu'elle est en ligne.
interface Props { youtube?: string; titre: string; matiere?: string; niveau?: string; chapitre?: string; court?: string }
const { youtube, titre, matiere, niveau, chapitre, court } = Astro.props;
---
{youtube ? (
  <a class="thumb" href={`https://www.youtube.com/watch?v=${youtube}`} target="_blank" rel="noopener" data-umami-event="video-youtube" aria-label={`Regarder sur YouTube : ${titre}`}>
    <img src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`} alt="" loading="lazy" referrerpolicy="no-referrer" />
    <span class="play"><i></i></span>
    <span class="bientot yt">Regarder sur YouTube</span>
  </a>
) : (
  <div class="thumb" role="img" aria-label="Vidéo bientôt en ligne" data-video-attente={niveau && chapitre ? `m=${matiere ?? 'maths'}&n=${niveau}&c=${chapitre}&t=${encodeURIComponent(court ?? titre)}` : undefined} data-titre={titre}>
    <svg viewBox="0 0 1600 900" aria-hidden="true">
      <rect width="1600" height="900" fill="#2B2BD9"/>
      <circle cx="1330" cy="250" r="300" fill="#F2E94E"/>
      <polygon points="980,900 1200,520 1420,900" fill="#FF7AA8"/>
      <rect x="1380" y="640" width="150" height="150" fill="#1A1A40"/>
      <foreignObject x="100" y="110" width="900" height="560"><div style="font-family:var(--f-titre);font-weight:800;font-stretch:75%;letter-spacing:-.03em;font-size:104px;line-height:.95;color:#fff">{titre}</div></foreignObject>
    </svg>
    <span class="bientot">Vidéo bientôt en ligne</span>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-video-attente]').forEach(async (el) => {
    try {
      const r = await fetch(`/api/video?${el.dataset.videoAttente}`);
      const { id } = await r.json();
      if (!id || !/^[\w-]{11}$/.test(id)) return;
      const a = document.createElement('a');
      a.className = 'thumb';
      a.href = `https://www.youtube.com/watch?v=${id}`;
      a.target = '_blank';
      a.rel = 'noopener';
      a.dataset.umamiEvent = 'video-youtube';
      a.setAttribute('aria-label', `Regarder sur YouTube : ${el.dataset.titre ?? ''}`);
      a.innerHTML = `<img src="https://i.ytimg.com/vi/${id}/hqdefault.jpg" alt="" loading="lazy" referrerpolicy="no-referrer" /><span class="play"><i></i></span><span class="bientot yt">Regarder sur YouTube</span>`;
      el.replaceWith(a);
      const t = document.querySelector('[data-abonne-txt]');
      if (t) t.textContent = 'Une vidéo par chapitre, sur la chaîne YouTube.';
    } catch { /* hors ligne : on garde « Vidéo bientôt en ligne » */ }
  });
</script>
