---
// Vignette de la vidéo : un clic ouvre la vidéo sur YouTube (nouvel onglet).
// Aucun lecteur YouTube n'est chargé sur le site, donc aucun cookie ni traceur.
interface Props { youtube?: string; titre: string; statique?: boolean }
const { youtube, titre, statique = false } = Astro.props;
---
{youtube && statique ? (
  <div class="thumb"><img src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`} alt="" loading="lazy" referrerpolicy="no-referrer" /><span class="play"><i></i></span></div>
) : youtube ? (
  <a class="thumb" href={`https://www.youtube.com/watch?v=${youtube}`} target="_blank" rel="noopener" data-umami-event="video-youtube" aria-label={`Regarder sur YouTube : ${titre}`}>
    <img src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`} alt="" loading="lazy" referrerpolicy="no-referrer" />
    <span class="play"><i></i></span>
    <span class="bientot yt">Regarder sur YouTube ↗</span>
  </a>
) : (
  <div class="thumb" role="img" aria-label="Vidéo bientôt en ligne">
    <svg viewBox="0 0 1600 900" aria-hidden="true">
      <rect width="1600" height="900" style="fill:var(--carte)"/>
      <foreignObject x="110" y="120" width="1380" height="420"><div style="font-family:var(--f-titre);font-weight:800;font-size:96px;line-height:1.1;color:var(--encre)">{titre}</div></foreignObject>
      <path transform="translate(1250 560) scale(9)" d="M12 1.5 C12.9 8 16 11.1 22.5 12 C16 12.9 12.9 16 12 22.5 C11.1 16 8 12.9 1.5 12 C8 11.1 11.1 8 12 1.5Z" style="fill:var(--surligneur);stroke:var(--encre);stroke-width:.6"/>
    </svg>
    <span class="bientot">Vidéo bientôt en ligne</span>
  </div>
)}
