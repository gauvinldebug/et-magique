---
// Le défi du jour : une question par jour et par niveau, la même pour tout le monde.
// Répondre chaque jour fait grandir la série (comptée sur l'appareil, sans compte ni cookie).
const niveaux = [
  ['6e', '6e'], ['5e', '5e'], ['4e', '4e'], ['3e', '3e'], ['seconde', '2de'], ['premiere', '1re'], ['terminale', 'Tle'],
];
---
<section class="dj" id="defi" aria-labelledby="t-defi" data-defi>
  <div class="dj-tete">
    <div>
      <span class="dj-k">Une question par jour</span>
      <h2 id="t-defi">Le défi du jour</h2>
    </div>
    <div class="dj-serie" data-serie title="Ta série : le nombre de jours d'affilée où tu as répondu">
      <svg viewBox="0 0 40 52" aria-hidden="true"><path d="M20 2 C 30 16 38 24 38 34 A 18 18 0 0 1 2 34 C 2 26 8 20 12 14 C 14 22 18 24 20 24 C 16 16 16 9 20 2 Z" fill="#FF7AA8" /><path d="M20 28 C 25 33 28 37 28 41 A 8 8 0 0 1 12 41 C 12 37 15 33 20 28 Z" fill="#F2E94E" /></svg>
      <span><b data-serie-n>0</b><small data-serie-txt>jour d'affilée</small></span>
    </div>
  </div>
  <div class="dj-niveaux" role="group" aria-label="Ton niveau">
    {niveaux.map(([slug, court]) => <button type="button" data-niveau={slug} aria-pressed="false">{court}</button>)}
  </div>
  <div class="dj-carte" data-carte aria-live="polite">
    <p class="dj-attente">Choisis ton niveau pour voir la question du jour.</p>
  </div>
</section>

<script>
  const track = (e: string, d?: object) => (window as any).umami?.track(e, d);
  type Q = { q: string; c: string[]; b: number; e: string; h: string; t: string; m: string };
  type Etat = { niveau?: string; dernier?: number; serie?: number; record?: number; jour?: number; faits?: Record<string, number>; questions?: Record<string, Q> };
  const CLE = 'defi-du-jour';
  const lire = (): Etat => { try { return JSON.parse(localStorage.getItem(CLE) || '{}'); } catch { return {}; } };
  const ecrire = (e: Etat) => { try { localStorage.setItem(CLE, JSON.stringify(e)); } catch { /* navigation privée */ } };
  // Numéro du jour, à l'heure de l'appareil : la question change à minuit.
  const aujourdhui = () => { const d = new Date(); return Math.floor((d.getTime() - d.getTimezoneOffset() * 60000) / 864e5); };
  const lettres = 'ABCDE';

  const racine = document.querySelector<HTMLElement>('[data-defi]');
  if (racine) {
    const carte = racine.querySelector<HTMLElement>('[data-carte]')!;
    const boutons = [...racine.querySelectorAll<HTMLButtonElement>('[data-niveau]')];
    const jour = aujourdhui();
    let etat = lire();
    // Nouvelle journée : on oublie les réponses d'hier.
    if (etat.jour !== jour) { etat.jour = jour; etat.faits = {}; etat.questions = {}; ecrire(etat); }

    const serieActuelle = () => (etat.dernier !== undefined && etat.dernier >= jour - 1 ? etat.serie ?? 0 : 0);
    const afficherSerie = () => {
      const n = serieActuelle();
      racine.querySelector<HTMLElement>('[data-serie-n]')!.textContent = String(n);
      const fait = etat.dernier === jour;
      racine.querySelector<HTMLElement>('[data-serie-txt]')!.textContent =
        n === 0 ? 'jour : réponds pour lancer ta série' : `${n > 1 ? 'jours' : 'jour'} d'affilée${fait ? '' : ', réponds pour continuer'}${(etat.record ?? 0) > n ? ` · record ${etat.record}` : ''}`;
      racine.querySelector<HTMLElement>('[data-serie]')!.classList.toggle('vive', fait);
    };

    const dessiner = (niveau: string, q: Q) => {
      const deja = etat.faits?.[niveau];
      carte.innerHTML = `
        <a class="dj-source" href="${q.h}">${q.m} · ${q.t}</a>
        <p class="qtext">${q.q}</p>
        <div class="ans">${q.c.map((c, i) => `<button type="button" data-c="${i}"><span class="lt">${lettres[i]}</span><span>${c}</span></button>`).join('')}</div>
        <div class="fb" data-fb hidden><b data-fb-titre></b><div>${q.e}</div><a href="${q.h}cours/">Revoir le chapitre →</a></div>
        <p class="dj-fin" data-fin hidden></p>`;
      const btns = [...carte.querySelectorAll<HTMLButtonElement>('[data-c]')];
      const montrer = (choix: number, anime: boolean) => {
        const ok = choix === q.b;
        btns.forEach((x) => { x.disabled = true; });
        btns[q.b].classList.add('good');
        if (!ok) btns[choix].classList.add('bad');
        const fb = carte.querySelector<HTMLElement>('[data-fb]')!;
        fb.hidden = false; fb.classList.add(ok ? 'ok' : 'ko');
        carte.querySelector<HTMLElement>('[data-fb-titre]')!.textContent = ok ? 'Bien joué !' : 'Pas tout à fait.';
        const fin = carte.querySelector<HTMLElement>('[data-fin]')!;
        fin.hidden = false;
        fin.textContent = 'Une nouvelle question demain. Reviens pour faire durer ta série.';
        if (anime) racine.querySelector('[data-serie]')!.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.18)' }, { transform: 'scale(1)' }], { duration: 500, easing: 'ease-out' });
      };
      btns.forEach((b) => b.addEventListener('click', () => {
        const choix = Number(b.dataset.c);
        etat = lire();
        etat.faits = { ...(etat.faits ?? {}), [niveau]: choix };
        if (etat.dernier !== jour) {
          etat.serie = etat.dernier === jour - 1 ? (etat.serie ?? 0) + 1 : 1;
          etat.dernier = jour;
          etat.record = Math.max(etat.record ?? 0, etat.serie);
        }
        ecrire(etat);
        afficherSerie();
        montrer(choix, true);
        track('defi-du-jour', { niveau, reussi: choix === q.b, serie: etat.serie });
      }));
      if (deja !== undefined) montrer(deja, false);
    };

    const charger = async (niveau: string) => {
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.niveau === niveau)));
      etat = lire(); etat.niveau = niveau; ecrire(etat);
      // La question du jour est gardée une fois tirée : une mise à jour du site dans la journée ne la change pas.
      let q = etat.questions?.[niveau];
      if (!q) {
        carte.innerHTML = '<p class="dj-attente">Chargement de la question…</p>';
        try {
          const r = await fetch(`/defi/${niveau}.json`);
          const { questions } = await r.json() as { questions: Q[] };
          if (!questions.length) { carte.innerHTML = '<p class="dj-attente">Pas encore de question pour ce niveau.</p>'; return; }
          const h = Math.imul(jour ^ 0x9e3779b9, 2654435761) >>> 0;
          q = questions[h % questions.length];
          etat = lire(); etat.questions = { ...(etat.questions ?? {}), [niveau]: q }; ecrire(etat);
        } catch { carte.innerHTML = '<p class="dj-attente">La question n\'a pas pu se charger. Vérifie ta connexion.</p>'; return; }
      }
      dessiner(niveau, q);
    };

    boutons.forEach((b) => b.addEventListener('click', () => charger(b.dataset.niveau!)));
    afficherSerie();
    if (etat.niveau) charger(etat.niveau);
  }
</script>

<style is:global>
  .dj { display: grid; gap: 22px; padding: clamp(24px, 4vw, 44px); background: var(--carte); border: 3px solid var(--encre); box-shadow: 12px 12px 0 var(--rose); }
  .dj-tete { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .dj-k { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--encre-2); }
  .dj h2 { font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 800; font-stretch: 75%; letter-spacing: -.035em; line-height: .9; margin-top: 6px; }
  .dj-serie { display: flex; align-items: center; gap: 12px; padding: 10px 16px 10px 12px; background: var(--encre); color: var(--feuille); }
  .dj-serie svg { width: 34px; height: 44px; flex: none; filter: grayscale(1) opacity(.55); transition: filter .4s; }
  .dj-serie.vive svg { filter: none; }
  .dj-serie b { display: block; font-family: var(--f-titre); font-size: 2rem; font-weight: 800; line-height: 1; }
  .dj-serie small { display: block; font-size: .78rem; opacity: .8; max-width: 210px; }
  .dj-niveaux { display: flex; flex-wrap: wrap; gap: 8px; }
  .dj-niveaux button { min-width: 52px; padding: 8px 14px; border: 2px solid var(--encre); background: transparent; color: var(--encre); font-weight: 700; font-size: .92rem; cursor: pointer; }
  .dj-niveaux button:hover { background: var(--jaune); color: var(--ink); }
  .dj-niveaux button[aria-pressed="true"] { background: var(--encre); color: var(--feuille); }
  .dj-carte { display: grid; gap: 16px; max-width: 680px; min-height: 60px; }
  .dj-attente { color: var(--encre-2); margin: 0; }
  .dj-fin { margin: 0; font-weight: 600; }
  .dj-source { justify-self: start; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--encre-2); text-decoration: none; border-bottom: 2px solid var(--jaune); }
</style>
