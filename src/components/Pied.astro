---
import Logo from './Logo.astro';
import Reseaux from './Reseaux.astro';
import { MATIERES } from '../data/site';
const yt = MATIERES[0].youtube;
---
<footer class="pied">
  <div class="wrap">
    <Logo size="1rem" />
    <span>Gratuit, sans compte, sans publicité. © Maths et Magique, <a href="/mentions-legales/#droits-dauteur">tous droits réservés</a>. Usage personnel uniquement : toute republication ou utilisation commerciale est interdite sans accord.</span>
    <Reseaux libelles />
    <div class="liens">
      {yt && <a href={yt} target="_blank" rel="noopener">Chaîne YouTube ↗</a>}
      <a href="/a-propos/">À propos</a>
      <a href="/demandes/">Nous écrire</a>
      <a href="/confidentialite/">Confidentialité</a>
      <a href="/mentions-legales/">Mentions légales</a>
    </div>
  </div>
</footer>
