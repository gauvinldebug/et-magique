---
// Barre fine tout en haut des sites de matière : revenir à l'accueil Et Magique et changer de matière.
import { MATIERES } from '../data/site';
interface Props { matiere?: string }
const { matiere = 'maths' } = Astro.props;
---
<div class="gbar">
  <div class="wrap">
    <a class="gbar-home" href="/" data-umami-event="retour-accueil">
      <svg class="gbar-chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg>
      <span class="gbar-long">Toutes les matières</span><span class="gbar-court">Matières</span>
    </a>
    <nav aria-label="Matières">
      {MATIERES.map((m) => m.active ? (
        <a href={`/${m.slug}/`} aria-current={m.slug === matiere ? 'page' : undefined} style={`--c:${m.couleur}`}>{m.nom}</a>
      ) : (
        <span title="Bientôt">{m.nom}</span>
      ))}
    </nav>
  </div>
</div>
