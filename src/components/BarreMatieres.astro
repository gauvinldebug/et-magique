---
// Barre du haut des sites de matière : revenir à l'accueil, ou changer de matière.
// Un seul bouton (la matière en cours) ouvre un panneau avec toutes les matières, en petites affiches.
// Le panneau tient sur téléphone même avec beaucoup de matières.
import { MATIERES, NIVEAUX } from '../data/site';
import { AFFICHES } from '../data/affiches';
interface Props { matiere?: string }
const { matiere = 'maths' } = Astro.props;
const court = (s: string) => NIVEAUX.find((n) => n.slug === s)?.court ?? s;
const PRINCIPAUX = ['6e', '5e', '4e', '3e', 'seconde', 'premiere', 'terminale'];
const etendue = (niveaux: string[] = PRINCIPAUX) => {
  const n = niveaux.filter((x) => PRINCIPAUX.includes(x));
  return n.length ? (n.length === 1 ? court(n[0]) : `${court(n[0])} à ${court(n[n.length - 1])}`) : '';
};
const mini = (slug: string) => {
  const a = AFFICHES[slug];
  return { fond: a?.fond ?? 'var(--ink)', forme: a?.forme ?? '' };
};
const ici = MATIERES.find((m) => m.slug === matiere) ?? MATIERES[0];
const miniIci = mini(ici.slug);
---
<div class="gbar">
  <div class="wrap">
    <a class="gbar-home" href="/" data-umami-event="retour-accueil">
      <span class="gbar-fleche" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6 8 12l6 6" /></svg></span>
      <span>Accueil</span>
    </a>
    <div class="gbar-choix" data-gbar>
      <button type="button" class="gbar-bouton" aria-expanded="false" aria-controls="gbar-panneau" data-gbar-bouton>
        <span class="gbar-mini" style={`--fond:${miniIci.fond}`} aria-hidden="true"><Fragment set:html={miniIci.forme} /></span>
        <span>{ici.nom}</span>
        <svg class="gbar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        <span class="sr-only">, changer de matière</span>
      </button>
      <div class="gbar-panneau" id="gbar-panneau" hidden data-gbar-panneau>
        <p class="gbar-titre">Changer de matière</p>
        <nav aria-label="Matières" data-profil-groupe>
          <ul>
            {MATIERES.map((m) => {
              const x = mini(m.slug);
              const vignette = <span class="gbar-mini" style={`--fond:${x.fond}`} aria-hidden="true"><Fragment set:html={x.forme} /></span>;
              const texte = <span class="gbar-nom"><b>{m.nom}</b><small>{m.active ? etendue(m.niveaux) : 'Bientôt'}</small></span>;
              return (
                <li data-matiere={m.slug} class:list={{ 'gbar-bientot': !m.active }}>
                  {m.active
                    ? <a href={`/${m.slug}/`} aria-current={m.slug === matiere ? 'page' : undefined} data-umami-event="changer-matiere">{vignette}{texte}</a>
                    : <span>{vignette}{texte}</span>}
                </li>
              );
            })}
          </ul>
          <div class="gbar-pied">
            <button type="button" class="perso-b petit" data-profil-ouvrir><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" /></svg><span data-profil-libelle>Personnaliser</span></button>
            <button type="button" class="profil-tout-b" data-profil-tout hidden>Tout afficher</button>
          </div>
        </nav>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gbar]').forEach((racine) => {
    const bouton = racine.querySelector<HTMLButtonElement>('[data-gbar-bouton]')!;
    const panneau = racine.querySelector<HTMLElement>('[data-gbar-panneau]')!;
    const ouvrir = (oui: boolean) => {
      panneau.hidden = !oui;
      bouton.setAttribute('aria-expanded', String(oui));
      document.documentElement.classList.toggle('gbar-ouvert', oui);
      if (oui) panneau.querySelector<HTMLElement>('a[aria-current], a')?.focus({ preventScroll: true });
    };
    bouton.addEventListener('click', () => ouvrir(panneau.hidden));
    panneau.querySelector('[data-profil-ouvrir]')?.addEventListener('click', () => ouvrir(false));
    document.addEventListener('click', (e) => { if (!panneau.hidden && !racine.contains(e.target as Node)) ouvrir(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panneau.hidden) { ouvrir(false); bouton.focus(); } });
  });
</script>
