---
// etmagique.fr : la porte d'entrée. Une matière = une chaîne YouTube = un site.
// Charte « Sommaire » : un manuel suisse, noir, blanc et un rouge ; l'accueil est le sommaire du programme.
import Base from '../layouts/Base.astro';
import Reseaux from '../components/Reseaux.astro';
import Histoire from '../components/Histoire.astro';
import Pied from '../components/Pied.astro';
import QRCode from 'qrcode';
import { MATIERES, SITE } from '../data/site';
import Recherche from '../components/Recherche.astro';
import Profil from '../components/Profil.astro';
import DerniereVideo from '../components/DerniereVideo.astro';
import { AFFICHES } from '../data/affiches';
import { chapitresPublies } from '../lib/contenu';

const principale = MATIERES.find((m) => m.active)!;
const publies = await chapitresPublies();
const nb = (slug: string) => publies.filter((c) => c.matiere === slug).length;
const abonnement = principale.youtube ? `${principale.youtube}?sub_confirmation=1` : '';
const qr = abonnement ? await QRCode.toString(abonnement, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#000000', light: '#FFFFFF' } }) : '';

---
<Base titre={`${SITE.nom} : les cours de la 6e à la terminale, enfin clairs`} description={`${SITE.nom} : vidéos, cours, exercices corrigés et QCM de maths gratuits, de la 6e à la terminale et pour le bac. Sans compte, sans publicité.`} sansEntete>
  <header class="ah" data-scroll>
    <svg class="ah-formes" viewBox="0 0 800 760" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <circle class="f-rond" cx="540" cy="250" r="330" fill="#F2E94E" />
      <polygon class="f-tri" points="120,760 370,330 620,760" fill="#FF7AA8" />
      <path class="f-courbe" d="M0 800 Q 360 -260 840 640" fill="none" stroke="#fff" stroke-width="10" pathLength="1" />
      <rect class="f-carre" x="600" y="520" width="150" height="150" fill="#1A1A40" />
    </svg>
    <div class="wrap">
      <div class="ah-tete">
        <a class="wordmark" href="/" aria-label={`${SITE.nom}, accueil`}>{SITE.nom}</a>
        <nav aria-label="Matières">
          {MATIERES.map((m) => m.active ? <a href={`/${m.slug}/`}>{m.nom}</a> : <span>{m.nom}</span>)}
        </nav>
      </div>
      <div class="ah-corps">
        <h1>Les cours de la 6e à la terminale, enfin clairs.</h1>
        <div class="ah-cta">
          <a class="btn jaune grand" href="#matieres">Choisir ma matière</a>
          <span>Gratuit, sans compte, sans publicité.</span>
        </div>
        <div class="ah-rq"><Recherche id="rq-site" matiere="toutes" placeholder="Cherche un chapitre dans toutes les matières" /></div>
      </div>
    </div>
  </header>
  <Profil />
  {principale.youtube && (
    <section class="nv-accueil" aria-labelledby="t-nv">
      <div class="wrap">
        <p class="profil-k" id="t-nv">Nouvelle vidéo</p>
        <DerniereVideo matiere={principale.slug} />
      </div>
    </section>
  )}
  <Histoire />
  <div class="portail-p">
    <div class="wrap">
      <section class="bloc" id="matieres" aria-labelledby="t-matieres">
        <h2 id="t-matieres" data-rv>Choisis ta matière.</h2>
        <div class="bloc-c" data-profil-groupe><ul class="p-affiches">
          {MATIERES.map((m, i) => {
            const a = AFFICHES[m.slug] ?? { fond: 'var(--ink)', txt: '#fff', forme: '' };
            const style = `--fond:${a.fond};--txt:${a.txt};--i:${i}`;
            const contenu = (
              <>
                <span class="poster-forme" aria-hidden="true"><Fragment set:html={a.forme} /></span>
                <span class="poster-txt"><b>{m.nom}</b><span>{m.active ? `${nb(m.slug)} chapitres en ligne, ${({ nsi: 'de la seconde à la terminale', technologie: 'de la 5e à la 3e' } as Record<string, string>)[m.slug] ?? 'de la 6e à la terminale'}.` : 'Bientôt'}</span></span>
              </>
            );
            return (
              <li data-rv style={`--i:${i}`} data-matiere={m.slug}>
                {m.active
                  ? <a class:list={['poster', { grand: i === 0 }]} href={`/${m.slug}/`} style={style}>{contenu}</a>
                  : <div class="poster" style={style}>{contenu}</div>}
              </li>
            );
          })}
        </ul>
        <button type="button" class="profil-tout-b" data-profil-tout hidden>Tout afficher</button>
        </div>
      </section>

      {principale.youtube && (
        <section class="p-chaine" id="chaine" aria-labelledby="t-chaine" data-rv data-scroll>
          <svg class="p-chaine-formes" viewBox="0 0 400 300" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <circle class="f-rond" cx="330" cy="250" r="120" fill="#FF7AA8" />
            <rect class="f-carre" x="200" y="200" width="80" height="80" fill="#2B2BD9" />
          </svg>
          <div class="p-chaine-txt">
            <h2 id="t-chaine">Ne rate aucun nouveau chapitre.</h2>
            <p>Abonne-toi à {principale.nom} et Magique sur YouTube pour être prévenu dès qu'une vidéo sort.</p>
            <div class="a-cta">
              <a class="btn" href={abonnement} target="_blank" rel="noopener" data-umami-event="chaine-portail">S'abonner sur YouTube</a>
            </div>
            <div class="portail-reseaux"><span>Aussi sur</span><Reseaux matiere={principale.slug} libelles /></div>
          </div>
          <figure class="chaine-qr">
            <Fragment set:html={qr} />
            <figcaption>Scanne avec ton téléphone</figcaption>
          </figure>
        </section>
      )}
    </div>
  </div>
  <Pied />
</Base>
