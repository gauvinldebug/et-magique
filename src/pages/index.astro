---
// etmagique.fr : la porte d'entrée. Une matière = une chaîne YouTube = un site.
// Charte « Sommaire » : un manuel suisse, noir, blanc et un rouge ; l'accueil est le sommaire du programme.
import Base from '../layouts/Base.astro';
import Reseaux from '../components/Reseaux.astro';
import Histoire from '../components/Histoire.astro';
import Pied from '../components/Pied.astro';
import QRCode from 'qrcode';
import { MATIERES } from '../data/site';
import { chapitresPublies } from '../lib/contenu';

const principale = MATIERES.find((m) => m.active)!;
const publies = await chapitresPublies();
const nb = (slug: string) => publies.filter((c) => c.matiere === slug).length;
const abonnement = principale.youtube ? `${principale.youtube}?sub_confirmation=1` : '';
const qr = abonnement ? await QRCode.toString(abonnement, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#000000', light: '#FFFFFF' } }) : '';
// Chaque matière a son affiche : un aplat, une forme qui dit la matière, le texte en dessous (jamais sur la forme).
const AFFICHES: Record<string, { fond: string; txt: string; forme: string }> = {
  // une parabole devant un disque
  maths: { fond: 'var(--bleu)', txt: '#fff', forme: '<svg viewBox="0 0 320 220" preserveAspectRatio="xMaxYMin meet"><circle class="f-a" cx="190" cy="110" r="95" fill="#F2E94E"/><path class="f-b" d="M70 210 Q 190 -90 310 210" fill="none" stroke="#1A1A40" stroke-width="12" stroke-linecap="round"/></svg>' },
  // une onde
  physique: { fond: 'var(--orange)', txt: 'var(--ink)', forme: '<svg viewBox="-8 0 256 120" preserveAspectRatio="xMidYMid meet"><path class="f-b" d="M0 60 Q 30 0 60 60 T 120 60 T 180 60 T 240 60" fill="none" stroke="#1A1A40" stroke-width="8" stroke-linecap="round"/></svg>' },
  // une double hélice : l'ADN
  svt: { fond: 'var(--vert)', txt: '#fff', forme: '<svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMin meet"><g stroke-width="10" stroke-linecap="round"><path d="M70 30 H130 M70 80 H130 M70 120 H130 M70 170 H130" stroke="#fff" opacity=".55"/><path class="f-a" d="M50 10 C 50 60, 150 60, 150 100 S 50 140, 50 190" fill="none" stroke="#F2E94E"/><path class="f-b" d="M150 10 C 150 60, 50 60, 50 100 S 150 140, 150 190" fill="none" stroke="#fff"/></g></svg>' },
  // un sablier : le temps qui passe
  histoire: { fond: 'var(--brique)', txt: '#fff', forme: '<svg viewBox="0 0 140 200" preserveAspectRatio="xMaxYMin meet"><rect x="10" y="8" width="120" height="14" fill="#fff"/><rect x="10" y="178" width="120" height="14" fill="#fff"/><polygon points="24,22 116,22 70,100" fill="#fff"/><polygon points="70,100 116,178 24,178" fill="#fff"/><polygon class="f-a" points="70,128 100,178 40,178" fill="#F2E94E"/></svg>' },
  // des guillemets : la parole, le texte
  francais: { fond: 'var(--violet)', txt: '#fff', forme: '<svg viewBox="0 0 200 160" preserveAspectRatio="xMaxYMin meet"><text class="f-a" x="0" y="150" font-family="Georgia,serif" font-size="220" fill="#FF7AA8">«</text></svg>' },
};
---
<Base titre="Et Magique : les cours de la 6e à la terminale, enfin clairs" description="Maths et Magique : vidéos, cours, exercices corrigés et QCM de maths gratuits, de la 6e à la terminale et pour le bac. Sans compte, sans publicité." sansEntete>
  <header class="ah" data-scroll>
    <svg class="ah-formes" viewBox="0 0 800 760" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <circle class="f-rond" cx="540" cy="250" r="330" fill="#F2E94E" />
      <polygon class="f-tri" points="120,760 370,330 620,760" fill="#FF7AA8" />
      <path class="f-courbe" d="M0 800 Q 360 -260 840 640" fill="none" stroke="#fff" stroke-width="10" pathLength="1" />
      <rect class="f-carre" x="600" y="520" width="150" height="150" fill="#1A1A40" />
    </svg>
    <div class="wrap">
      <div class="ah-tete">
        <a class="wordmark" href="/" aria-label="Et Magique, accueil">Et Magique</a>
        <nav aria-label="Matières">
          {MATIERES.map((m) => m.active ? <a href={`/${m.slug}/`}>{m.nom}</a> : <span>{m.nom}</span>)}
        </nav>
      </div>
      <div class="ah-corps">
        <h1>Les cours de la 6e à la terminale, enfin clairs.</h1>
        <div class="ah-cta">
          <a class="btn jaune grand" href={`/${principale.slug}/`}>Commencer avec les maths</a>
          <span>Gratuit, sans compte, sans publicité.</span>
        </div>
      </div>
    </div>
  </header>
  <Histoire />
  <div class="portail-p">
    <div class="wrap">
      <section class="bloc" aria-labelledby="t-matieres">
        <h2 id="t-matieres" data-rv>Choisis ta matière.</h2>
        <ul class="bloc-c p-affiches">
          {MATIERES.map((m, i) => {
            const a = AFFICHES[m.slug] ?? { fond: 'var(--ink)', txt: '#fff', forme: '' };
            const style = `--fond:${a.fond};--txt:${a.txt};--i:${i}`;
            const contenu = (
              <>
                <span class="poster-forme" aria-hidden="true"><Fragment set:html={a.forme} /></span>
                <span class="poster-txt"><b>{m.nom}</b><span>{m.active ? `${nb(m.slug)} chapitres en ligne, de la 6e à la terminale.` : 'Bientôt'}</span></span>
              </>
            );
            return (
              <li data-rv style={`--i:${i}`}>
                {m.active
                  ? <a class:list={['poster', { grand: i === 0 }]} href={`/${m.slug}/`} style={style}>{contenu}</a>
                  : <div class="poster" style={style}>{contenu}</div>}
              </li>
            );
          })}
        </ul>
      </section>

      {principale.youtube && (
        <section class="p-chaine" id="chaine" aria-labelledby="t-chaine" data-rv data-scroll>
          <svg class="p-chaine-formes" viewBox="0 0 400 300" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <circle class="f-rond" cx="330" cy="250" r="120" fill="#FF7AA8" />
            <rect class="f-carre" x="200" y="200" width="80" height="80" fill="#2B2BD9" />
          </svg>
          <div class="p-chaine-txt">
            <h2 id="t-chaine">Ne rate aucun nouveau chapitre.</h2>
            <p>Abonne-toi à {principale.nom} et Magique sur YouTube pour être prévenu dès qu'une vidéo sort.</p>
            <div class="a-cta">
              <a class="btn" href={abonnement} target="_blank" rel="noopener" data-umami-event="chaine-portail">S'abonner sur YouTube</a>
            </div>
            <div class="portail-reseaux"><span>Aussi sur</span><Reseaux matiere={principale.slug} libelles /></div>
          </div>
          <figure class="chaine-qr">
            <Fragment set:html={qr} />
            <figcaption>Scanne avec ton téléphone</figcaption>
          </figure>
        </section>
      )}
    </div>
  </div>
  <Pied />
</Base>
