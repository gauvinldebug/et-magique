---
import Base from '../../../layouts/Base.astro';
import Bandeau from '../../../components/Bandeau.astro';
import { MATIERES, niveauxDe, nomDans } from '../../../data/site';
import { programmeNiveau } from '../../../lib/contenu';
export async function getStaticPaths() {
  return MATIERES.filter((m) => m.active).flatMap((m) => niveauxDe(m.slug).map((n) => ({ params: { matiere: m.slug, niveau: n.slug }, props: { matiere: m, niveau: n } })));
}
const { matiere, niveau } = Astro.props;
const liste = await programmeNiveau(matiere.slug, niveau.slug);
const nbDispo = liste.filter((c) => c.dispo).length;
---
<Base titre={`${matiere.nom} en ${niveau.nom} : tous les chapitres`} description={`Les chapitres de ${nomDans(matiere.slug)} de ${niveau.nom}${niveau.sousTitre ? ` (${niveau.sousTitre})` : ''} : vidéos, cours, exercices corrigés et QCM gratuits.`} matiere={matiere.slug} niveau={niveau.slug}>
  <div class="page-feuille cahier">
    <div class="feuille">
      <Bandeau niveau={niveau.slug}>
        <div class="crumb"><a href={`/${matiere.slug}/`}>Accueil</a> › <b>{niveau.nom}</b></div>
        <h1>{niveau.nom}{niveau.sousTitre ? <span class="sous"> · {niveau.sousTitre}</span> : null}</h1>
        <p>{nbDispo === 0 ? 'Les chapitres arrivent bientôt. Dis-nous lequel tu veux en premier.' : `${nbDispo} chapitre${nbDispo > 1 ? 's' : ''} en ligne, les autres arrivent.`}</p>
      </Bandeau>
      <ul class="liste-ch">
        {liste.map((c, i) => (
          <li>
            {c.dispo ? (
              <a href={`/${matiere.slug}/${niveau.slug}/${c.slug}/`}><span class="n">{i + 1}</span><b>{c.titre}</b>{c.nouveau ? <span class="badge">Nouveau</span> : c.video ? <span class="badge gris">Vidéo</span> : <span></span>}</a>
            ) : (
              <div class="later"><span class="n">{i + 1}</span><span>{c.titre}</span><span class="badge gris">Bientôt</span></div>
            )}
          </li>
        ))}
      </ul>
      <div class="nextstep"><span>Un chapitre te manque ?</span><a class="btn ghost" href={`/demandes/?niveau=${niveau.slug}`}>Le demander</a></div>
    </div>
  </div>
</Base>
