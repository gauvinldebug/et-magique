---
import Base from '../../../layouts/Base.astro';
import Bandeau from '../../../components/Bandeau.astro';
import { MATIERES, niveauxDe, nomDans } from '../../../data/site';
import { programmeNiveau } from '../../../lib/contenu';
export async function getStaticPaths() {
  return MATIERES.filter((m) => m.active).flatMap((m) => niveauxDe(m.slug).map((n) => ({ params: { matiere: m.slug, niveau: n.slug }, props: { matiere: m, niveau: n } })));
}
const { matiere, niveau } = Astro.props;
const liste = await programmeNiveau(matiere.slug, niveau.slug);
const nbDispo = liste.filter((c) => c.dispo).length;
---
<Base titre={`${matiere.nom} en ${niveau.nom} : tous les chapitres`} description={`Les chapitres de ${nomDans(matiere.slug)} de ${niveau.nom}${niveau.sousTitre ? ` (${niveau.sousTitre})` : ''} : vidéos, cours, exercices corrigés et QCM gratuits.`} matiere={matiere.slug} niveau={niveau.slug}>
  <div class="page-feuille cahier">
    <div class="feuille">
      <Bandeau niveau={niveau.slug}>
        <div class="crumb"><a href={`/${matiere.slug}/`}>Accueil</a> › <b>{niveau.nom}</b></div>
        <h1>{niveau.nom}{niveau.sousTitre ? <span class="sous"> · {niveau.sousTitre}</span> : null}</h1>
        <p>{nbDispo === 0 ? 'Les chapitres arrivent bientôt. Dis-nous lequel tu veux en premier.' : nbDispo === liste.length ? `Les ${nbDispo} chapitres du programme, tous en ligne.` : `${nbDispo} chapitre${nbDispo > 1 ? 's' : ''} en ligne, les autres arrivent.`}</p>
      </Bandeau>
      {nbDispo > 1 && (
        <a class="hasard-cta" href={`/${matiere.slug}/${niveau.slug}/hasard/`} data-umami-event="hasard-ouvert">
          <span><b>10 questions au hasard</b><small>Sur tous les chapitres de {niveau.nom}. Idéal pour réviser.</small></span>
          <span class="btn jaune">C'est parti →</span>
        </a>
      )}
      {nbDispo > 1 && (
        <div class="parcours" hidden data-parcours={`${matiere.slug}/${niveau.slug}`}>
          <div class="parcours-cases">{liste.filter((c) => c.dispo).map((c, i) => <i data-c={c.slug} style={`--i:${i}`} title={c.titre}></i>)}</div>
          <p data-parcours-texte></p>
        </div>
      )}
      <ul class="liste-ch">
        {liste.map((c, i) => (
          <li data-c={c.dispo ? c.slug : undefined}>
            {c.dispo ? (
              <a href={`/${matiere.slug}/${niveau.slug}/${c.slug}/`}><span class="n">{i + 1}</span><b>{c.titre}</b>{c.nouveau ? <span class="badge">Nouveau</span> : c.video ? <span class="badge gris">Vidéo</span> : <span></span>}</a>
            ) : (
              <div class="later"><span class="n">{i + 1}</span><span>{c.titre}</span><span class="badge gris">Bientôt</span></div>
            )}
          </li>
        ))}
      </ul>
      <div class="nextstep"><span>Un chapitre te manque ?</span><a class="btn ghost" href={`/demandes/?niveau=${niveau.slug}`}>Le demander</a></div>
    </div>
  </div>
</Base>
<script>
  const bloc = document.querySelector<HTMLElement>('[data-parcours]');
  if (bloc) {
    let vus: string[] = [];
    try {
      vus = JSON.parse(localStorage.getItem('faits:' + bloc.dataset.parcours) || '[]');
      localStorage.removeItem('vus:' + bloc.dataset.parcours); // ancien suivi automatique, abandonné
    } catch { /* rien */ }
    const cases = [...bloc.querySelectorAll<HTMLElement>('[data-c]')];
    const faits = cases.filter((c) => vus.includes(c.dataset.c!));
    if (faits.length) {
      faits.forEach((c) => c.classList.add('ok'));
      document.querySelectorAll<HTMLElement>('.liste-ch li[data-c]').forEach((li) => { if (vus.includes(li.dataset.c!)) li.classList.add('deja'); });
      const suivant = cases.find((c) => !vus.includes(c.dataset.c!));
      const t = bloc.querySelector<HTMLElement>('[data-parcours-texte]')!;
      const n = faits.length, total = cases.length;
      t.innerHTML = n === total
        ? `<b>Les ${total} chapitres sont cochés.</b> Il ne reste plus qu'à tout réviser avec les QCM.`
        : `<b>${n} chapitre${n > 1 ? 's' : ''} sur ${total}</b> terminé${n > 1 ? 's' : ''}, d'après tes coches sur cet appareil.`;
      if (suivant && n < total) {
        const a = document.createElement('a');
        a.href = `${location.pathname.replace(/\/?$/, '/')}${suivant.dataset.c}/`;
        a.textContent = `Le suivant : ${suivant.title} →`;
        t.append(' ', a);
      }
      bloc.hidden = false;
    }
  }
</script>
