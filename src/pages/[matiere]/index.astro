---
import Base from '../../layouts/Base.astro';
import DerniereVideo from '../../components/DerniereVideo.astro';
import Recherche from '../../components/Recherche.astro';
import Chaine from '../../components/Chaine.astro';
import { NIVEAUX } from '../../data/site';
import { cheminsMatieres } from '../../lib/matieres-paths';
export const getStaticPaths = cheminsMatieres;
const { matiere } = Astro.props;
---
<Base titre="Maths et Magique : les maths de la 6e à la terminale, enfin claires" description="Maths et Magique : tout le programme de maths de la 6e à la terminale en vidéo, avec cours, exercices corrigés pas à pas, QCM, fiches et annales du bac. Gratuit, sans compte, sans publicité." matiere={matiere.slug} actif="accueil">
  <div class="page-feuille cahier">
    <div class="feuille">
      <div class="s-hero m-hero">
        <div>
          <h1>Tout le programme de maths, expliqué en vidéo et <mark>corrigé pas à pas</mark>.</h1>
          <p class="lead">De la 6e à la terminale, options comprises. Gratuit, sans compte, sans publicité.</p>
          <div style="margin-top:20px"><Recherche id="rq-accueil" /></div>
          <div class="levels" aria-label="Choisis ton niveau">
            {NIVEAUX.map((n) => <a href={`/${matiere.slug}/${n.slug}/`}>{n.court}</a>)}
          </div>
        </div>
        <DerniereVideo matiere={matiere.slug} />
      </div>
      {matiere.youtube && <Chaine url={matiere.youtube} nom={`${matiere.nom} et Magique`} />}
      <div class="band">
        <div><h2>Bac 2027 : ton planning de travail</h2><p>Chaque semaine jusqu'à l'épreuve, un e‑mail avec les chapitres à revoir et les exercices à faire.</p></div>
        <a class="btn jaune" href={`/${matiere.slug}/planning-bac/`}>Recevoir mon planning</a>
      </div>
    </div>
  </div>
</Base>
