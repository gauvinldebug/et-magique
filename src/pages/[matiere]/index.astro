---
import Base from '../../layouts/Base.astro';
import DerniereVideo from '../../components/DerniereVideo.astro';
import Recherche from '../../components/Recherche.astro';
import Chaine from '../../components/Chaine.astro';
import Sommaire from '../../components/Sommaire.astro';
import { cheminsMatieres } from '../../lib/matieres-paths';
export const getStaticPaths = cheminsMatieres;
const { matiere } = Astro.props;
// Les textes de l'accueil d'une matière.
const TEXTES: Record<string, { titre: string; description: string; h1: string; chapeau: string }> = {
  maths: {
    titre: 'Maths et Magique : les maths de la 6e à la terminale, enfin claires',
    description: 'Maths et Magique : tout le programme de maths de la 6e à la terminale en vidéo, avec cours, exercices corrigés pas à pas, QCM, fiches et annales du bac. Gratuit, sans compte, sans publicité.',
    h1: 'Tout le programme de maths, expliqué simplement.',
    chapeau: 'De la 6e à la terminale, options comprises. Vidéo, cours, exercices corrigés et QCM pour chaque chapitre. Gratuit, sans compte, sans publicité.',
  },
  physique: {
    titre: 'Physique-chimie et Magique : la physique-chimie de la 6e à la terminale, enfin claire',
    description: 'Tout le programme de physique-chimie de la 6e à la terminale : cours avec une image pour chaque notion, exercices corrigés pas à pas, QCM et fiches à imprimer. Gratuit, sans compte, sans publicité.',
    h1: 'Toute la physique-chimie, expliquée simplement.',
    chapeau: 'De la 6e (sciences et technologie) à la terminale spécialité, avec la partie physique-chimie de l\'enseignement scientifique. Cours, exercices corrigés et QCM pour chaque chapitre. Gratuit, sans compte, sans publicité.',
  },
  svt: {
    titre: 'SVT et Magique : les SVT du lycée, enfin claires',
    description: 'Le programme de SVT du lycée, seconde, spécialité de première et terminale, enseignement scientifique : cours avec une image pour chaque notion, exercices corrigés pas à pas, QCM et fiches à imprimer. Gratuit, sans compte, sans publicité.',
    h1: 'Les SVT, expliquées simplement.',
    chapeau: 'Seconde, première et terminale spécialité, et la partie SVT de l\'enseignement scientifique. Le collège arrive ensuite. Cours, exercices corrigés et QCM pour chaque chapitre. Gratuit, sans compte, sans publicité.',
  },
};
const tx = TEXTES[matiere.slug] ?? TEXTES.maths;
---
<Base titre={tx.titre} description={tx.description} matiere={matiere.slug} actif="accueil">
  <div class="page-feuille cahier">
    <div class="feuille" style="gap:clamp(56px, 7vw, 96px)">
      <div class="m-hero" data-scroll>
        <svg class="m-hero-formes" viewBox="0 0 700 520" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
          <circle class="f-rond" cx="520" cy="170" r="250" fill="#F2E94E" />
          <polygon class="f-tri" points="180,520 360,210 540,520" fill="#FF7AA8" />
          {matiere.slug === 'svt'
            ? <path class="f-courbe" d="M300 40 C 300 160, 520 160, 520 280 S 300 400, 300 520" fill="none" stroke="#fff" stroke-width="9" pathLength="1" />
            : matiere.slug === 'physique'
            ? <path class="f-courbe" d="M230 300 Q 310 140 390 300 T 550 300 T 710 300" fill="none" stroke="#fff" stroke-width="9" pathLength="1" />
            : <path class="f-courbe" d="M40 560 Q 380 -140 760 420" fill="none" stroke="#fff" stroke-width="9" pathLength="1" />}
          <rect class="f-carre" x="560" y="390" width="110" height="110" fill="#1A1A40" />
        </svg>
        <h1>{tx.h1}</h1>
        <div class="m-hero-txt">
          <p>{tx.chapeau}</p>
          <Recherche id="rq-accueil" matiere={matiere.slug} />
        </div>
      </div>
      <Sommaire matiere={matiere.slug} />
      {matiere.youtube && (
      <section class="bloc" aria-labelledby="t-video">
        <h2 id="t-video">Dernière vidéo</h2>
        <div class="bloc-c"><DerniereVideo matiere={matiere.slug} /></div>
      </section>
      )}
      {matiere.bac && (
      <div class="band">
        <div><h2>Bac 2027 : ton planning de travail</h2><p>Chaque semaine jusqu'à l'épreuve, un e‑mail avec les chapitres à revoir et les exercices à faire.</p></div>
        <a class="btn" href={`/${matiere.slug}/planning-bac/`}>Recevoir mon planning</a>
      </div>
      )}
      {matiere.youtube && <Chaine url={matiere.youtube} nom={`${matiere.nom} et Magique`} />}
    </div>
  </div>
</Base>
