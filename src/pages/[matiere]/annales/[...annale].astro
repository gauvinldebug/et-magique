---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Bandeau from '../../../components/Bandeau.astro';
export async function getStaticPaths() {
  return (await getCollection('annales')).map((a) => ({ params: { matiere: a.data.matiere, annale: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
---
<Base titre={a.data.titre} description={`${a.data.titre} : sujet et corrigé détaillé.`} matiere={a.data.matiere} actif="annales">
  <div class="page-feuille cahier">
    <div class="feuille">
      <Bandeau teinte="violet" petit>
        <div class="crumb"><a href={`/${a.data.matiere}/annales/`}>Annales</a> › <b>{a.data.session} {a.data.annee}</b></div>
        <h1>{a.data.titre}</h1>
      </Bandeau>
      {a.data.sujet && <a class="dl" href={a.data.sujet} download><span class="ic">PDF</span><div><b>Le sujet</b><small>{a.data.session} {a.data.annee}</small></div></a>}
      <article class="prose"><Content /></article>
    </div>
  </div>
</Base>
