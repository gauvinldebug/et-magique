---
import Base from './Base.astro';
import Bandeau from '../components/Bandeau.astro';
interface Props { titre?: string; description?: string; frontmatter?: { titre: string; description?: string } }
const titre = Astro.props.frontmatter?.titre ?? Astro.props.titre ?? '';
const description = Astro.props.frontmatter?.description ?? Astro.props.description;
---
<Base titre={titre} description={description}>
  <div class="page-feuille cahier">
    <div class="feuille">
      <Bandeau teinte="jaune" petit><h1>{titre}</h1></Bandeau>
      <article class="prose"><slot /></article>
    </div>
  </div>
</Base>
