---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/impression.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import BarreMatieres from '../components/BarreMatieres.astro';
import { MATIERES } from '../data/site';

interface Props {
  titre: string;
  description?: string;
  matiere?: string;
  niveau?: string;
  actif?: string;
  indexer?: boolean; // false : pas dans Google ni dans la recherche du site
  sansEntete?: boolean;
}
const { titre, description = 'Les maths de la 6e à la terminale, enfin claires. Vidéos, cours, exercices corrigés pas à pas et QCM. Gratuit, sans compte.', matiere = 'maths', niveau, actif, indexer = true, sansEntete = false } = Astro.props;
const site = Astro.site ?? new URL('https://et-magique.netlify.app');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
const verifGoogle = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const m = MATIERES[0];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'EducationalOrganization', '@id': `${site.origin}/#org`, name: 'Maths et Magique', alternateName: ['Et Magique', 'Maths & Magique', 'mathsetmagique'], url: site.origin, logo: new URL('/favicon.svg', site).href, sameAs: [m.youtube, m.instagram].filter(Boolean) },
    { '@type': 'WebSite', '@id': `${site.origin}/#site`, name: 'Maths et Magique', alternateName: 'Et Magique', url: site.origin, inLanguage: 'fr-FR', publisher: { '@id': `${site.origin}/#org` } },
  ],
};
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
const pleinTitre = titre.includes('Magique') ? titre : `${titre} · Maths et Magique`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pleinTitre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1A1A40" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11112B" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pleinTitre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Maths et Magique" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {verifGoogle && <meta name="google-site-verification" content={verifGoogle} />}
    {indexer && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    {!indexer && <meta name="robots" content="noindex" />}
    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-domains={`etmagique.fr,www.etmagique.fr,${site.host}`}></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#contenu">Aller au contenu</a>
    {!sansEntete && <BarreMatieres matiere={matiere} />}
    {!sansEntete && <Entete matiere={matiere} niveau={niveau} actif={actif} />}
    <main id="contenu" data-pagefind-body={indexer ? '' : undefined}>
      <slot />
    </main>
    {!sansEntete && <Pied />}
    <script is:inline>
      // Hébergement Netlify gratuit : un badge « Powered by Netlify » obligatoire s'affiche en bas à droite.
      // On le détecte pour laisser de la place sous la barre de menu du bas au lieu de la masquer.
      (function () {
        var r = document.documentElement;
        var voir = function () { if (document.getElementById('nl-badge-frame')) { r.classList.add('nf-badge'); return true; } };
        if (voir()) return;
        var o = new MutationObserver(function () { if (voir()) o.disconnect(); });
        o.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(function () { o.disconnect(); }, 10000);
      })();
    </script>
    <script>
      // Défilement : les blocs apparaissent quand on arrive dessus, les formes des affiches bougent avec la page.
      // Rien ne bouge si l'appareil demande moins d'animations. Seules les zones visibles sont recalculées.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const root = document.documentElement;
        root.classList.add('anim');
        const cibles = '.bloc > h2, .som-tete, .som-grille > li, .p-affiches > li, .p-chaine, .dv, .band, .chaine, .lvl-grid, .liste-ch > li, .exo, .encadre, .nextstep';
        const vu = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('vu'); vu.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll<HTMLElement>(cibles).forEach((el) => {
          const freres = el.parentElement ? [...el.parentElement.children].filter((c) => c.matches(cibles)) : [];
          if (freres.length > 1) el.style.setProperty('--i', String(Math.min(freres.indexOf(el), 8)));
          el.classList.add('rv');
          vu.observe(el);
        });
        const zones = new Set<HTMLElement>();
        const suit = new IntersectionObserver((es) => es.forEach((e) => {
          e.isIntersecting ? zones.add(e.target as HTMLElement) : zones.delete(e.target as HTMLElement);
        }));
        document.querySelectorAll<HTMLElement>('[data-scroll]').forEach((z) => suit.observe(z));
        // Amorti léger : avec une molette crantée, les formes glissent au lieu de sauter.
        const vals = new Map<HTMLElement, number>();
        let boucle = 0, avant = 0;
        const maj = (now: number) => {
          const dt = Math.min(64, now - (avant || now)); avant = now;
          const h = innerHeight, k = 1 - Math.exp(-dt / 90);
          let encore = false;
          zones.forEach((z) => {
            const r = z.getBoundingClientRect();
            const p = Math.min(1, Math.max(0, (h - r.top) / (h + r.height)));
            const p0 = r.top <= 0 ? -r.top / (r.height || 1) : 0;
            const c = z.matches('.ah, .m-hero') ? Math.min(1, p0) : p;
            const v0 = vals.get(z) ?? c;
            const v = Math.abs(c - v0) < .001 ? c : v0 + (c - v0) * k;
            if (v !== c) encore = true;
            vals.set(z, v);
            z.style.setProperty('--p', v.toFixed(4));
          });
          boucle = encore ? requestAnimationFrame(maj) : 0;
          if (!boucle) avant = 0;
        };
        addEventListener('scroll', () => { if (!boucle) boucle = requestAnimationFrame(maj); }, { passive: true });
      }
    </script>
  </body>
</html>
