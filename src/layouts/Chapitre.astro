---
import Base from './Base.astro';
import EnteteImpression from '../components/EnteteImpression.astro';
import Bandeau from '../components/Bandeau.astro';
import type { ChapitreProps } from '../lib/routes';

type Onglet = 'video' | 'cours' | 'exercices' | 'qcm';
interface Props extends ChapitreProps { onglet: Onglet; titrePage?: string }
const { chapitre, niveau, matiere, exercices, qcm, onglet, titrePage } = Astro.props;
const base = `/${matiere.slug}/${niveau.slug}/${chapitre.slug}`;
const onglets: { id: Onglet; href: string; titre: string; n?: number }[] = [
  { id: 'video', href: `${base}/`, titre: 'Vidéo' },
  { id: 'cours', href: `${base}/cours/`, titre: 'Cours' },
  { id: 'exercices', href: `${base}/exercices/`, titre: 'Exercices', n: exercices.length },
  { id: 'qcm', href: `${base}/qcm/`, titre: 'QCM', n: qcm.length },
];
const i = onglets.findIndex((o) => o.id === onglet);
const prochain = onglets[i + 1];
// Les mots qui désignent une autre partie du chapitre sont des liens directs.
const lien = (href: string, texte: string) => `<a href="${href}">${texte}</a>`;
const fiche = lien(`${base}/fiche/`, 'la fiche de révision');
const phrases: Record<Onglet, string> = {
  video: `Vu la vidéo ? Relis ${lien(`${base}/cours/`, 'le cours')}, puis passe aux ${lien(`${base}/exercices/`, 'exercices')}.`,
  cours: `Le cours est clair ? Passe aux ${lien(`${base}/exercices/`, 'exercices')}, et garde ${fiche} pour réviser.`,
  exercices: `Fini les exercices ? Teste-toi avec le ${lien(`${base}/qcm/`, 'QCM')}, ou relis ${lien(`${base}/cours/`, 'le cours')}.`,
  qcm: `Prêt pour la suite ? Garde ${fiche} pour réviser avant le contrôle.`,
};
const titre = titrePage ?? (onglet === 'video' ? chapitre.data.titre : `${chapitre.data.court} : ${onglets[i].titre.toLowerCase()}`);
---
<Base titre={`${titre} · ${niveau.nom}`} description={chapitre.data.description} matiere={matiere.slug} niveau={niveau.slug}>
  <div class="page-feuille cahier">
    <div class="feuille">
      <EnteteImpression niveau={niveau.slug} niveauNom={matiere.slug === 'maths' ? niveau.nom : `${matiere.nom} · ${niveau.nom}`} matiere={matiere.slug} type={{ video: 'Cours', cours: 'Cours', exercices: 'Exercices corrigés', qcm: 'QCM' }[onglet]} titre={chapitre.data.titre} adresse={`etmagique.fr${base}/`} />
      <Bandeau niveau={niveau.slug} petit>
        <div class="crumb"><a href={`/${matiere.slug}/${niveau.slug}/`}>{niveau.nom}</a> › <b>{chapitre.data.court}</b></div>
        <h1 data-pagefind-meta="title">{chapitre.data.titre}</h1>
      </Bandeau>
      <nav class="ch-tabs" aria-label="Parties du chapitre">
        {onglets.map((o) => (
          <a href={o.href} aria-current={o.id === onglet ? 'page' : undefined}>{o.titre}{o.n ? <small>{o.n}</small> : null}</a>
        ))}
      </nav>
      <slot />
      <div class="fini no-print" hidden data-fini={`${matiere.slug}/${niveau.slug}`} data-ch={chapitre.slug}>
        <button type="button" class="fini-case" aria-pressed="false"><i aria-hidden="true"></i><span>J'ai terminé ce chapitre</span></button>
        <p>Coche quand tu as lu le cours et fait les exercices. La liste des chapitres le retient, sur cet appareil.</p>
      </div>
      <div class="nextstep">
        <span set:html={phrases[onglet]} />
        {prochain ? (
          <a class="btn" href={prochain.href}>{prochain.id === 'cours' ? 'Lire le cours' : prochain.id === 'exercices' ? 'Faire les exercices' : 'Faire le QCM'} →</a>
        ) : Astro.props.suivant?.publie ? (
          <a class="btn" href={`/${matiere.slug}/${niveau.slug}/${Astro.props.suivant.slug}/`}>{Astro.props.suivant.titre} →</a>
        ) : (
          <a class="btn ghost" href={`/${matiere.slug}/${niveau.slug}/`}>Tous les chapitres de {niveau.nom}</a>
        )}
      </div>
      <p class="aide no-print">Une erreur dans cette page ? <a href={`/demandes/?type=erreur&niveau=${niveau.slug}&page=${encodeURIComponent(Astro.url.pathname)}`}>Signale-la</a>, je corrige vite.</p>
    </div>
  </div>
</Base>
<script>
  // L'élève coche lui-même le chapitre quand il l'a terminé. Rien n'est coché à la simple ouverture.
  const bloc = document.querySelector<HTMLElement>('[data-fini]');
  if (bloc) {
    try {
      const cle = 'faits:' + bloc.dataset.fini, ch = bloc.dataset.ch!;
      const lire = (): string[] => JSON.parse(localStorage.getItem(cle) || '[]');
      const b = bloc.querySelector<HTMLButtonElement>('.fini-case')!;
      const maj = (oui: boolean) => {
        b.setAttribute('aria-pressed', String(oui));
        b.querySelector('span')!.textContent = oui ? 'Chapitre terminé' : "J'ai terminé ce chapitre";
      };
      maj(lire().includes(ch));
      b.addEventListener('click', () => {
        const faits = lire().filter((c) => c !== ch);
        const oui = b.getAttribute('aria-pressed') !== 'true';
        if (oui) faits.push(ch);
        localStorage.setItem(cle, JSON.stringify(faits));
        maj(oui);
        if (oui) (window as any).umami?.track('chapitre-termine', { chapitre: bloc.dataset.fini + '/' + ch });
      });
      bloc.hidden = false;
    } catch { /* stockage indisponible : on n'affiche pas la case */ }
  }
</script>
