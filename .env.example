# À régler dans Cloudflare Pages : projet > Settings > Variables and Secrets (production ET preview)
# (ancien hébergeur Netlify : Site configuration > Environment variables). Mettre les clés en « Secret ».
# Cloudflare demande aussi : Compatibility flags = nodejs_compat, et un KV namespace lié sous le nom DONNEES.
SITE_URL=                # adresse publique : https://etmagique.fr (canonique, sitemap)
NODE_VERSION=22
ADMIN_PASSWORD=          # mot de passe de etmagique.fr/admin
ADMIN_SECRET=            # une longue phrase aléatoire (signe les connexions admin)
PUBLIC_UMAMI_ID=         # identifiant du site dans Umami Cloud
PUBLIC_UMAMI_SHARE_URL=  # lien de partage du tableau de bord Umami (affiché dans /admin)
BREVO_API_KEY=           # clé API Brevo (onglet « API Keys », commence par xkeysib-, pas la clé SMTP). Désactiver le blocage des IP inconnues dans Brevo › Security.
# Après tout changement de variable dans Netlify : redéployer pour que les fonctions la prennent en compte.
BREVO_LIST_ID=           # facultatif : liste Brevo où ranger les inscrits confirmés
BREVO_EXPEDITEUR=        # adresse d'envoi validée dans Brevo (ex. bonjour@etmagique.fr)
BUILD_HOOK_URL=          # Build hook Netlify : reconstruit le site quand une vidéo sort
YOUTUBE_CHANNEL_ID=      # facultatif (sinon trouvé via @mathsetmagique)
