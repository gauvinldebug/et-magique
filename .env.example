# À régler dans Netlify : Site configuration > Environment variables
ADMIN_PASSWORD=          # mot de passe de etmagique.fr/admin
ADMIN_SECRET=            # une longue phrase aléatoire (signe les connexions admin)
PUBLIC_UMAMI_ID=         # identifiant du site dans Umami Cloud
PUBLIC_UMAMI_SHARE_URL=  # lien de partage du tableau de bord Umami (affiché dans /admin)
BREVO_API_KEY=           # e-mail de confirmation + planning (Brevo, gratuit)
BREVO_LIST_ID=           # facultatif : liste Brevo où ranger les inscrits confirmés
BREVO_EXPEDITEUR=        # adresse d'envoi validée dans Brevo (ex. bonjour@etmagique.fr)
BUILD_HOOK_URL=          # Build hook Netlify : reconstruit le site quand une vidéo sort
YOUTUBE_CHANNEL_ID=      # facultatif (sinon trouvé via @mathsetmagique)
